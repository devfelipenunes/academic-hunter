# Dependencies
.venv/
venv/
node_modules/

# Runtime data
.academic_hunter/
# Anchored: unanchored, it would also match a nested `results/`.
/results/
*.db

# Build artifacts
dist/
*.egg-info/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
.coverage
.pytest_cache/
# ruff writes its own `.gitignore` holding `*` inside this directory, so it
# stays out of `git status` without this line -- but only for as long as that
# file survives, and nothing here would notice the day it does not.
.ruff_cache/

.claude/
.gemini/
.cursor/

# MCP client wiring — generated by install.py with this checkout's absolute path.
# Same reasoning as config.json below: it names the machine it was written on,
# and the client's only symptom is a generic "failed to connect".
.mcp.json
.codex/config.toml

# User config (has API keys)
config.json
/config.json
config*.json
!/config.example.json
# `config*.json` requires the name to end in `.json`, so a hand-made snapshot
# like `config.json.bak-antes-merge-context-rules` slipped through and sat in
# `git status` with the API keys still in it.
config.json.bak*

# `uv.lock` is generated by a tool nothing here runs: the CI and the Makefile
# install with pip, and the `uvx` in the README resolves the published package
# rather than this checkout.
/uv.lock

# A personal document, not part of the project.
/plano-pesquisa-mestrado.html

# The neutral fallback that ships inside the package. Anchored on purpose: an
# unanchored `!config.default.json` would re-include a file of that name at any
# depth, which is how `mutants/config.example.json` once ended up in a build.
# The cost of getting this wrong is silent —
# hatchling applies these rules to the wheel, so an ignored file is a file that
# never embarks, and the symptom is a FileNotFoundError in production only.
!src/academic_hunter/core/infra/config.default.json

# mutmut sandbox — rebuild it with `mutmut run`; 7 MB of copies, not source
mutants/
