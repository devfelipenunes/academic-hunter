# Dependencies
.venv/
venv/
node_modules/

# Runtime data
.academic_hunter/
# Anchored: an unanchored `results/` also matched papers/experiments/results/,
# which holds the experiment artifacts the manuscripts cite. Those are small and
# must travel with the repo — an artifact nobody can obtain is an artifact
# nobody can check.
/results/
*.db

# Build artifacts
dist/
*.egg-info/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
.coverage
.pytest_cache/

# Local agent wiring — these name an absolute path to this machine's
# interpreter, which is useless in a clone and leaks the author's disk layout.
# `.gemini/` was missed when `.mcp.json` was fixed; the other runtimes are listed
# so the next one does not repeat it.
#
# `.mcp.json` is deliberately NOT here: it is tracked, and portable — it calls
# `academic-mcp` by name rather than by path.
.claude/
.gemini/
.cursor/

# User config (has API keys)
config.json
/config.json
config*.json
!config.example.json
